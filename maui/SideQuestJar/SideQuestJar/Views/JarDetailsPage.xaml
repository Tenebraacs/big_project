<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SideQuestJar.ViewModels"
             xmlns:models="clr-namespace:SideQuestJar.Models"
             x:Class="SideQuestJar.Views.JarDetailsPage"
             x:DataType="viewmodels:JarDetailsViewModel"
             Title="Challenge Details">

    <ContentPage.Background>
        <RadialGradientBrush Center="0.5,0.5" Radius="0.9">
            <GradientStop Color="#775655" Offset="0.0" />
            <GradientStop Color="#232733" Offset="1.0" />
        </RadialGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *, Auto" Padding="30,50">

        <VerticalStackLayout Grid.Row="0" Spacing="10" HorizontalOptions="Center" Margin="0,0,0,30">
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" HeightRequest="150" WidthRequest="150" HorizontalOptions="Center">
                <Image Source="{Binding CurrentJar.Picture}" Aspect="AspectFill" BackgroundColor="#32495A" />
            </Border>
            <Label Text="{Binding CurrentJar.Name}" FontSize="32" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
            <Label Text="{Binding CurrentJar.Description}" FontSize="16" TextColor="#A0B0BA" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="3" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="60, *, 60" ColumnSpacing="15" VerticalOptions="Center">

            <Button Grid.Column="0" Text="&#x25C0;" Clicked="ScrollLeft_Clicked" BackgroundColor="#32495A" TextColor="White" CornerRadius="30" HeightRequest="60" VerticalOptions="Center"/>

            <CollectionView x:Name="QuestsCarousel" 
                            Grid.Column="1" 
                            ItemsSource="{Binding Quests}" 
                            HorizontalScrollBarVisibility="Never" 
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="20" SnapPointsType="MandatorySingle" SnapPointsAlignment="Center" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:JarQuest">
                        <Border BackgroundColor="#EABCAE" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20" WidthRequest="260" HeightRequest="320">
                            <VerticalStackLayout Spacing="10">
                                <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" HeightRequest="140">
                                    <Image Source="{Binding Picture}" Aspect="AspectFill" BackgroundColor="White" />
                                </Border>
                                <Label Text="{Binding Title}" FontSize="22" FontAttributes="Bold" TextColor="#222222" HorizontalOptions="Center" />
                                <BoxView HeightRequest="1" Color="#BFA29E" Margin="20,0" />
                                <Label Text="{Binding Description}" FontSize="14" TextColor="#444444" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Column="2" Text="&#x25B6;" Clicked="ScrollRight_Clicked" BackgroundColor="#32495A" TextColor="White" CornerRadius="30" HeightRequest="60" VerticalOptions="Center"/>
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="10" Margin="0,30,0,0">
            <Button Command="{Binding JoinJarCommand}" 
                    CornerRadius="25" 
                    HeightRequest="60" 
                    WidthRequest="300" 
                    HorizontalOptions="Center" 
                    FontAttributes="Bold" FontSize="18">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsJoined}" Value="False">
                        <Setter Property="Text" Value="Join Jar" />
                        <Setter Property="BackgroundColor" Value="#476273" />
                        <Setter Property="TextColor" Value="White" />
                        <Setter Property="IsEnabled" Value="True" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsJoined}" Value="True">
                        <Setter Property="Text" Value="Joined!" />
                        <Setter Property="BackgroundColor" Value="#2E3B42" />
                        <Setter Property="TextColor" Value="#A0B0BA" />
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Label Text="{Binding GenericErrorMessage}" 
                   TextColor="#D32F2F" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>