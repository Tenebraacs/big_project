<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:SideQuestJar.Components"
             xmlns:viewmodels="clr-namespace:SideQuestJar.ViewModels"
             xmlns:models="clr-namespace:SideQuestJar.Models"
             x:Class="SideQuestJar.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             x:Name="ThisPage"
             Title="Home">

    <ContentPage.Background>
        <RadialGradientBrush Center="0.5,0.5" Radius="0.9">
            <GradientStop Color="#775655" Offset="0.0" />
            <GradientStop Color="#232733" Offset="1.0" />
        </RadialGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *">
        <components:NavbarView Grid.Row="0" BindingContext="{Binding AppState}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="50" Spacing="30">

                <Border BackgroundColor="#32495A" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="30" WidthRequest="400" HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,5" Opacity="0.2" Radius="10" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border StrokeShape="RoundRectangle 40" StrokeThickness="0" HeightRequest="80" WidthRequest="80" HorizontalOptions="Center">
                            <Image Source="{Binding CurrentUser.ProfilePicture}" Aspect="AspectFill" />
                        </Border>
                        <Label Text="{Binding CurrentUser.Username, StringFormat='@{0}'}" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <BoxView HeightRequest="1" Color="#476273" Margin="0,5" />
                        <Label Text="{Binding CurrentUser.Fullname}" TextColor="#A0B0BA" FontSize="16" HorizontalOptions="Center" />
                        <Label Text="{Binding CurrentUser.UserXp, StringFormat='Total XP: {0}'}" TextColor="#EABCAE" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="TODAY'S CHALLENGE" FontSize="26" FontAttributes="Bold" TextColor="White" Margin="0,0,0,-10"/>

                <Border BackgroundColor="#EABCAE" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="30">
                    <Grid ColumnDefinitions="300, *" ColumnSpacing="40">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 15" StrokeThickness="0">
                            <Image Source="{Binding MainJar.Picture}" HeightRequest="200" Aspect="AspectFill"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="15">
                            <Label Text="{Binding MainJar.Name}" FontSize="32" FontAttributes="Bold" TextColor="#222222" />
                            <Label Text="{Binding MainQuest.Title}" FontSize="20" TextColor="#444444" />
                            <Button Text="Let's get started" BackgroundColor="#476273" TextColor="White" CornerRadius="15" HeightRequest="50" WidthRequest="250" HorizontalOptions="Start" Margin="0,10,0,0"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="MOST POPULAR" FontSize="24" FontAttributes="Bold" TextColor="White" Margin="0,20,0,-10"/>

                <Grid ColumnDefinitions="50, *, 50" ColumnSpacing="20">
                    <Button Grid.Column="0" Text="&#x25C0;" Clicked="ScrollLeft_Clicked" BindingContext="{x:Reference PopularCarousel}" BackgroundColor="#32495A" TextColor="White" CornerRadius="25" HeightRequest="50" VerticalOptions="Center"/>

                    <CollectionView x:Name="PopularCarousel" Grid.Column="1" ItemsSource="{Binding PopularJars}" HorizontalScrollBarVisibility="Never" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="20" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Jar">
                                <Border BackgroundColor="#32495A" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="20"
                                        WidthRequest="{Binding CalculatedCardWidth, Source={x:Reference ThisPage}}">
                                    <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Image Source="{Binding Picture}" HeightRequest="100" Aspect="AspectFit" />
                                        <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation"/>
                                        <Button Text="Show Jar" BackgroundColor="#EABCAE" TextColor="#222222" CornerRadius="10" HeightRequest="40" Margin="0, 10, 0, 0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=NavigateToJarDetailsCommand}" CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Grid.Column="2" Text="&#x25B6;" Clicked="ScrollRight_Clicked" BindingContext="{x:Reference PopularCarousel}" BackgroundColor="#32495A" TextColor="White" CornerRadius="25" HeightRequest="50" VerticalOptions="Center"/>
                </Grid>

                <Label Text="RECOMMENDED FOR YOU" FontSize="24" FontAttributes="Bold" TextColor="White" Margin="0,10,0,-10"/>

                <Grid ColumnDefinitions="50, *, 50" ColumnSpacing="20">
                    <Button Grid.Column="0" Text="&#x25C0;" Clicked="ScrollLeft_Clicked" BindingContext="{x:Reference RecommendedCarousel}" BackgroundColor="#E0B0A2" TextColor="#222222" CornerRadius="25" HeightRequest="50" VerticalOptions="Center"/>

                    <CollectionView x:Name="RecommendedCarousel" Grid.Column="1" ItemsSource="{Binding RecommendedJars}" HorizontalScrollBarVisibility="Never" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="20" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Jar">
                                <Border BackgroundColor="#E0B0A2" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="20"
                                        WidthRequest="{Binding CalculatedCardWidth, Source={x:Reference ThisPage}}">
                                    <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Image Source="{Binding Picture}" HeightRequest="100" Aspect="AspectFit" />
                                        <Label Text="{Binding Name}" TextColor="#222222" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation"/>
                                        <Button Text="Show Jar" BackgroundColor="#476273" TextColor="White" CornerRadius="10" HeightRequest="40" Margin="0, 10, 0, 0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=NavigateToJarDetailsCommand}" CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Grid.Column="2" Text="&#x25B6;" Clicked="ScrollRight_Clicked" BindingContext="{x:Reference RecommendedCarousel}" BackgroundColor="#E0B0A2" TextColor="#222222" CornerRadius="25" HeightRequest="50" VerticalOptions="Center"/>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>