<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:SideQuestJar.Components"
             xmlns:viewmodels="clr-namespace:SideQuestJar.ViewModels"
             xmlns:models="clr-namespace:SideQuestJar.Models"
             x:Class="SideQuestJar.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="Home">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryDark">#232733</Color>
            <Color x:Key="PrimaryCard">#32495A</Color>
            <Color x:Key="AccentPeach">#EABCAE</Color>
            <Color x:Key="AccentMuted">#E0B0A2</Color>
            <Color x:Key="TextLight">#A0B0BA</Color>
            <Color x:Key="ButtonBlue">#476273</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Background>
        <RadialGradientBrush Center="0.5,0.5" Radius="0.9">
            <GradientStop Color="#775655" Offset="0.0" />
            <GradientStop Color="{StaticResource PrimaryDark}" Offset="1.0" />
        </RadialGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *">
        <components:NavbarView Grid.Row="0" BindingContext="{Binding AppState}" />

        <ScrollView x:Name="MainScrollView" Grid.Row="1">
            <VerticalStackLayout Padding="50" Spacing="30">

                <Border BackgroundColor="{StaticResource PrimaryCard}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="30" WidthRequest="400" HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,5" Opacity="0.2" Radius="10" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border StrokeShape="RoundRectangle 40" StrokeThickness="0" HeightRequest="80" WidthRequest="80" HorizontalOptions="Center">
                            <Image Source="{Binding CurrentUser.ProfilePicture}" Aspect="AspectFill" />
                        </Border>
                        <Label Text="{Binding CurrentUser.Username, StringFormat='@{0}'}" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <BoxView HeightRequest="1" Color="{StaticResource ButtonBlue}" Margin="0,5" />
                        <Label Text="{Binding CurrentUser.Fullname}" TextColor="{StaticResource TextLight}" FontSize="16" HorizontalOptions="Center" />
                        <Label Text="{Binding CurrentUser.UserXp, StringFormat='Total XP: {0}'}" TextColor="{StaticResource AccentPeach}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="TODAY'S CHALLENGE" FontSize="26" FontAttributes="Bold" TextColor="White" Margin="0,0,0,-10"/>

                <Border BackgroundColor="{StaticResource AccentPeach}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="30">
                    <Grid ColumnDefinitions="300, *" ColumnSpacing="40">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 15" StrokeThickness="0">
                            <Image Source="{Binding MainJar.Picture}" HeightRequest="200" Aspect="AspectFill"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="15">
                            <Label Text="{Binding MainJar.Name}" FontSize="32" FontAttributes="Bold" TextColor="#222222" />
                            <Label Text="{Binding MainQuest.Title}" FontSize="20" TextColor="#444444" />
                            <Button Text="Let's get started" BackgroundColor="{StaticResource ButtonBlue}" TextColor="White" CornerRadius="15" HeightRequest="50" WidthRequest="250" HorizontalOptions="Start" Margin="0,10,0,0"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="MOST POPULAR" FontSize="24" FontAttributes="Bold" TextColor="White" Margin="0,20,0,-10"/>

                <Grid ColumnDefinitions="50, *, 50" ColumnSpacing="20">
                    <Button Grid.Column="0" Text="&#x25C0;" Clicked="ScrollLeft_Clicked" BindingContext="{x:Reference PopularCarousel}" BackgroundColor="{StaticResource PrimaryCard}" TextColor="White" CornerRadius="25" HeightRequest="50" VerticalOptions="Center"/>

                    <CollectionView x:Name="PopularCarousel" 
                                    Grid.Column="1" 
                                    HorizontalOptions="Center"
                                    WidthRequest="1080"
                                    ItemsSource="{Binding PopularJars}" 
                                    HorizontalScrollBarVisibility="Never" 
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="20" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Jar">
                                <Border BackgroundColor="{StaticResource PrimaryCard}" StrokeThickness="0" 
                                        StrokeShape="RoundRectangle 15" Padding="20"
                                        WidthRequest="200">
                                    <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Image Source="{Binding Picture}" HeightRequest="100" Aspect="AspectFit" />
                                        <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation"/>
                                        <Button Text="Show Jar" BackgroundColor="{StaticResource AccentPeach}" TextColor="#222222" CornerRadius="10" HeightRequest="40" Margin="0, 10, 0, 0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=NavigateToJarDetailsCommand}" CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Grid.Column="2" Text="&#x25B6;" Clicked="ScrollRight_Clicked" BindingContext="{x:Reference PopularCarousel}" BackgroundColor="{StaticResource PrimaryCard}" TextColor="White" CornerRadius="25" HeightRequest="50" VerticalOptions="Center"/>
                </Grid>

                <Label Text="RECOMMENDED FOR YOU" FontSize="24" FontAttributes="Bold" TextColor="White" Margin="0,10,0,-10"/>

                <Grid ColumnDefinitions="50, *, 50" ColumnSpacing="20">
                    <Button Grid.Column="0" Text="&#x25C0;" Clicked="ScrollLeft_Clicked" BindingContext="{x:Reference RecommendedCarousel}" BackgroundColor="{StaticResource AccentMuted}" TextColor="#222222" CornerRadius="25" HeightRequest="50" VerticalOptions="Center"/>

                    <CollectionView x:Name="RecommendedCarousel" 
                                    Grid.Column="1" 
                                    HorizontalOptions="Center"
                                    WidthRequest="1080"
                                    ItemsSource="{Binding RecommendedJars}" 
                                    HorizontalScrollBarVisibility="Never" 
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="20" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Jar">
                                <Border BackgroundColor="{StaticResource AccentMuted}" StrokeThickness="0" 
                                        StrokeShape="RoundRectangle 15" Padding="20"
                                        WidthRequest="200">
                                    <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Image Source="{Binding Picture}" HeightRequest="100" Aspect="AspectFit" />
                                        <Label Text="{Binding Name}" TextColor="#222222" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation"/>
                                        <Button Text="Show Jar" BackgroundColor="{StaticResource ButtonBlue}" TextColor="White" CornerRadius="10" HeightRequest="40" Margin="0, 10, 0, 0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=NavigateToJarDetailsCommand}" CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Grid.Column="2" Text="&#x25B6;" Clicked="ScrollRight_Clicked" BindingContext="{x:Reference RecommendedCarousel}" BackgroundColor="{StaticResource AccentMuted}" TextColor="#222222" CornerRadius="25" HeightRequest="50" VerticalOptions="Center"/>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>