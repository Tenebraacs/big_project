@page "/register"
@using SideQuestJar.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<div class="container min-vh-80 d-flex align-items-center py-5">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-lg-10">
            <div class="row rounded-5 bg-block-blue p-4 align-items-center shadow-lg">
                <!-- Left text side -->
                <div class="col-md-5 text-center text-md-start mb-4 mb-md-0 d-none d-md-block">
                    <h2 class="logo-first mt-3">SIDE QUEST</h2>
                    <h1 class="logo-second display-1">JAR</h1>
                    <br>
                    <p class="welcome-text m-1.5 fs-1" style="transform: rotate(5deg);">
                        Welcome to The Amazing Digital Side Quest Jar!
                    </p>
                </div>

                <!-- Right form side -->
                <div class="col-md-7">
                    <div class="card claim-modal-content rounded-5 border-0 shadow-sm">
                        <div class="card-header border-0 claim-modal-header pb-0" style="background: transparent;">
                            <h4 class="claim-modal-title m-0 fw-bold">Register</h4>
                        </div>

                        <div class="card-body claim-modal-body">
                            <EditForm Model="@this" OnValidSubmit="HandleRegister">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="claim-label">First Name</label>
                                        <InputText class="form-control claim-input" @bind-Value="FirstName" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="claim-label">Last Name</label>
                                        <InputText class="form-control claim-input" @bind-Value="LastName" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="claim-label">Username</label>
                                        <InputText class="form-control claim-input" @bind-Value="Username" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="claim-label">Birth Date</label>
                                        <InputDate class="form-control claim-input" @bind-Value="BirthDate" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="claim-label">Email Address</label>
                                    <InputText type="email" class="form-control claim-input" @bind-Value="Email" />
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="claim-label">Password</label>
                                        <InputText type="password" class="form-control claim-input" @bind-Value="Password" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="claim-label">Confirm Password</label>
                                        <InputText type="password" class="form-control claim-input" @bind-Value="PasswordConfirm" />
                                    </div>
                                </div>

                                @if(!string.IsNullOrEmpty(ErrorMessage))
                                {
                                    <div class="mt-2 small fw-bold mb-3" style="color:#FFD2C4;">
                                        @ErrorMessage
                                    </div>
                                }

                                <div class="d-flex flex-column gap-2 mt-4">
                                    <button type="submit" class="btn blue-button rounded-pill w-100 fw-bold fs-5 py-2">
                                        Register
                                    </button>
                                    <a href="/login" class="text-center text-white mt-2 text-decoration-none">Already have an account? Login</a>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    public string FirstName { get; set; } = "";
    public string LastName { get; set; } = "";
    public string Username { get; set; } = "";
    public string Email { get; set; } = "";
    public string Password { get; set; } = "";
    public string PasswordConfirm { get; set; } = "";
    public DateTime BirthDate { get; set; } = DateTime.Today.AddYears(-16);
    public string ErrorMessage { get; set; } = "";

    private async Task HandleRegister()
    {
        ErrorMessage = "";
        
        if (Password != PasswordConfirm)
        {
            ErrorMessage = "Passwords do not match.";
            return;
        }

        var result = await AuthService.RegisterAsync(Username, BirthDate.ToString("yyyy-MM-dd"), FirstName, LastName, Email, Password, PasswordConfirm);
        
        if (result.IsSuccess)
        {
            NavigationManager.NavigateTo("/login");
        }
        else
        {
            ErrorMessage = result.SummaryMessage;
        }
    }
}
