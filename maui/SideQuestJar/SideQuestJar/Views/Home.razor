@page "/"
@using SideQuestJar.Services
@using SideQuestJar.DTOs
@using Microsoft.AspNetCore.Components.Forms
@inject JarService JarService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="container-fluid px-0 px-md-3">
    @if (DiscoverData == null && !HasError)
    {
        <div class="d-flex justify-content-center align-items-center min-vh-80">
            <div class="spinner-border text-light" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (HasError)
    {
        <div class="d-flex flex-column justify-content-center align-items-center min-vh-80 text-center">
            <i class="bi bi-exclamation-triangle display-1 text-warning mb-3"></i>
            <h3 class="text-white fw-bold">Oops! Could not load the Discover feed.</h3>
            <p class="text-white-50">Please make sure the Laravel API is running on localhost:8000 and that you are connected.</p>
        </div>
    }
    else
    {
        <!-- Main Quest -->
        @if (DiscoverData.MainJar != null && DiscoverData.MainQuest != null)
        {
            <div class="row justify-content-center mb-5">
                <div class="col-12 col-md-10 col-xl-8 px-2 px-md-3">
                    <div class="card rounded-5 bg-block-blue mb-3 mx-1 mx-md-3 mt-md-3 mainjar-border shadow-lg">
                        <div class="text-center card-header border-0 px-4 px-md-5 pt-4 pb-0" style="background: transparent;">
                            <h1 class="fw-bold fs-1 display-md-3 welcome-text m-0">@DiscoverData.MainJar.Name</h1>
                        </div>

                        <div class="card-body p-3 p-md-4 pt-1">
                            <div class="row align-items-center g-3">
                                <div class="col-12 col-md-7 text-center text-md-start d-flex flex-column px-md-4 mt-0">
                                    <h2 class="fw-bold welcome-text mb-5" style="font-size: clamp(1.4rem, 2.5vw, 2.2rem); opacity: 0.95;">
                                        @DiscoverData.MainQuest.Title
                                    </h2>
                                    <p class="jar-name mb-0" style="font-size: clamp(1.15rem, 2.2vw, 1.45rem); opacity: 1; line-height: 1.5; margin-top: 1rem;">
                                        @DiscoverData.MainQuest.Description
                                    </p>
                                </div>

                                <div class="col-10 col-sm-8 col-md-5 mx-auto">
                                    <div class="rounded-5 overflow-hidden shadow-lg mx-auto" style="aspect-ratio: 1/1; max-width: 450px;">
                                        <img src="@(string.IsNullOrEmpty(DiscoverData.MainQuest.PictureUrl) ? "https://i.ibb.co/2YvZypwJ/Jar-Quest-Placeholder.png" : DiscoverData.MainQuest.PictureUrl)" 
                                             alt="Quest picture"
                                             class="img-fluid w-100 h-100"
                                             style="object-fit: cover;">
                                    </div>
                                </div>
                            </div>

                            <div class="text-center mt-3">
                                <button type="button" class="btn home-claim-button m-2 rounded-pill blue-button shadow"
                                        @onclick='() => OpenClaimModal(DiscoverData.MainQuest.Id)'>
                                    Claim
                                </button>
                                @if (!string.IsNullOrEmpty(questMessage))
                                {
                                    <div class="mt-2 small fw-bold" style="color:#EAB2A0;">@questMessage</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Recent Completions Feed (Today's Solutions) -->
        @if (completions.Any())
        {
            <CompletionCarousel Title="Today's Solutions" Completions="completions" />
        }

        <!-- ===== CLAIM QUEST MODAL ===== -->
        @if (showClaimModal)
        {
            <div style="position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:1060;" @onclick="CancelClaim"></div>

            <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:1061;width:min(92vw,500px);max-height:90vh;overflow-y:auto;">
                <div class="card bg-block-blue rounded-4 jar-card-border shadow-lg">
                    <div class="card-header border-0 d-flex align-items-center justify-content-between px-4 pt-4 pb-2"
                         style="background:transparent;">
                        <h4 class="fw-bold welcome-text mb-0">Claim Quest</h4>
                        <button class="btn btn-link text-white-50 p-0" @onclick="CancelClaim">
                            <i class="bi bi-x-lg fs-5"></i>
                        </button>
                    </div>
                    <div class="card-body px-4 pb-4" @onclick:stopPropagation>

                        <label class="fw-bold small mb-2 d-block" style="color:#EAB2A0;">Upload an image</label>
                        <div class="rounded-4 mb-3 d-flex align-items-center gap-3 px-3 py-2"
                             style="background:rgba(255,255,255,0.07);border:1.5px solid rgba(234,178,160,0.35);">
                            <InputFile OnChange="HandleImageSelected" accept="image/*" class="d-none" id="claimImageInput" />
                            <label for="claimImageInput" class="btn blue-button rounded-pill px-3 py-1 small mb-0"
                                   style="cursor:pointer;white-space:nowrap;">
                                <i class="bi bi-upload me-1"></i>Choose Image
                            </label>
                            <span class="text-white-50 small text-truncate">
                                @(selectedImageName ?? "No file selected")
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(selectedImageDataUrl))
                        {
                            <div class="crop-container mb-3">
                                <img id="cropperImg" alt="crop preview" style="max-width:100%;display:block;" />
                            </div>
                            <p class="text-white-50 small text-center mb-3">
                                <i class="bi bi-arrows-move me-1"></i>Drag to reposition · Resize the box to crop
                            </p>
                        }

                        <label class="fw-bold small mb-2 d-block" style="color:#EAB2A0;">
                            Description <span class="text-white-50 fw-normal">(optional)</span>
                        </label>
                        <textarea @bind="claimDescription"
                                  class="form-control claim-input rounded-4 mb-4"
                                  rows="3"
                                  placeholder="Add a short description about this claim"
                                  style="background:rgba(255,255,255,0.07);border-color:rgba(255,255,255,0.15);resize:none;"></textarea>

                        <div class="d-flex gap-3">
                            <button class="btn rounded-pill px-4 py-2 fw-bold flex-grow-1"
                                    style="background:rgba(234,178,160,0.85);color:#1a1f2e;"
                                    @onclick="CancelClaim">
                                Cancel
                            </button>
                            <button class="btn blue-button rounded-pill px-4 py-2 fw-bold flex-grow-1 shadow"
                                    @onclick="SubmitClaim" disabled="@isSubmittingClaim">
                                @if (isSubmittingClaim)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Submit
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Popular Jars Section -->
        @if (DiscoverData.PopularJars != null && DiscoverData.PopularJars.Any())
        {
            <JarCarousel Title="Most Popular Jars" Jars="@DiscoverData.PopularJars" OnLoadMore="LoadMorePopularJars" />
        }

        <!-- Recommended Jars Section -->
        @if (DiscoverData.RecommendedJars != null && DiscoverData.RecommendedJars.Any())
        {
            <JarCarousel Title="Recommended For You" Jars="@DiscoverData.RecommendedJars" OnLoadMore="LoadMoreRecommendedJars" />
        }

        <!-- Fallback if database is entirely empty -->
        @if ((DiscoverData.MainJar == null || DiscoverData.MainQuest == null) && 
             (DiscoverData.PopularJars == null || !DiscoverData.PopularJars.Any()) && 
             (DiscoverData.RecommendedJars == null || !DiscoverData.RecommendedJars.Any()))
        {
            <div class="d-flex flex-column justify-content-center align-items-center min-vh-80 text-center">
                <i class="bi bi-box-seam display-1 text-light opacity-50 mb-3"></i>
                <h3 class="text-white fw-bold">No Jars Found</h3>
                <p class="text-white-50">It looks like the database is empty. Create some Jars to see them here!</p>
            </div>
        }
    }
</div>

@code {
    private DiscoverResponse? DiscoverData;
    private bool HasError = false;

    private int popularPage = 1;
    private bool hasMorePopular = true;

    private int recommendedPage = 1;
    private bool hasMoreRecommended = true;

    private List<QuestCompletionDto> completions = new();
    
    // Modal state
    private bool showClaimModal = false;
    private int modalQuestId = -1;
    private string? claimDescription;
    private string? selectedImageName;
    private string? selectedImageDataUrl;
    private bool isSubmittingClaim = false;
    private string questMessage = "";
    private int claimingQuestId = -1;

    protected override async Task OnInitializedAsync()
    {
        DiscoverData = await JarService.GetDiscoverDataAsync();
        if (DiscoverData == null)
        {
            HasError = true;
        }
        else if (DiscoverData.MainJar != null)
        {
            var results = await JarService.GetCompletionsAsync(DiscoverData.MainJar.Id);
            completions = results.Where(c => DateTime.TryParse(c.CompletedAt, out var dt) && dt.Date == DateTime.Today).ToList();
        }
    }

    private async Task LoadMorePopularJars()
    {
        if (!hasMorePopular || DiscoverData == null) return;
        
        popularPage++;
        var response = await JarService.GetPopularJarsAsync(popularPage);
        
        if (response != null && response.Data != null && response.Data.Any())
        {
            DiscoverData.PopularJars.AddRange(response.Data);
            if (response.Data.Count < 10) hasMorePopular = false;
        }
        else
        {
            hasMorePopular = false;
        }
        StateHasChanged();
    }

    private async Task LoadMoreRecommendedJars()
    {
        if (!hasMoreRecommended || DiscoverData == null) return;
        
        recommendedPage++;
        var response = await JarService.GetRecommendedJarsAsync(recommendedPage);
        
        if (response != null && response.Data != null && response.Data.Any())
        {
            DiscoverData.RecommendedJars.AddRange(response.Data);
            if (response.Data.Count < 10) hasMoreRecommended = false;
        }
        else
        {
            hasMoreRecommended = false;
        }
        StateHasChanged();
    }

    private void OpenClaimModal(int questId)
    {
        modalQuestId         = questId;
        claimDescription     = null;
        selectedImageName     = null;
        selectedImageDataUrl  = null;
        showClaimModal       = true;
    }

    private async Task CancelClaim()
    {
        showClaimModal = false;
        await JS.InvokeVoidAsync("destroyCropper");
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;
            selectedImageName = file.Name;

            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024).CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            selectedImageDataUrl = $"data:image/jpeg;base64,{base64}";

            StateHasChanged();
            await Task.Yield();
            await JS.InvokeVoidAsync("initCropper", "cropperImg", selectedImageDataUrl);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Error selecting image: " + ex.Message);
        }
    }

    private async Task SubmitClaim()
    {
        if (isSubmittingClaim) return;
        
        try
        {
            isSubmittingClaim = true;
            showClaimModal    = false;

            claimingQuestId    = modalQuestId;
            questMessage       = "";

            byte[]? imageBytes = null;
            string? imageName  = null;
            if (!string.IsNullOrEmpty(selectedImageDataUrl))
            {
                var b64 = await JS.InvokeAsync<string?>("getCroppedImageBase64", 0.85);
                if (!string.IsNullOrEmpty(b64))
                {
                    imageBytes = Convert.FromBase64String(b64);
                    imageName  = "completion.jpg";
                }
                await JS.InvokeVoidAsync("destroyCropper");
            }

            var (success, message, completion) = await JarService.CompleteQuestAsync(
                modalQuestId, claimDescription, imageBytes, imageName);

            questMessage = message;
            if (success)
            {
                if (completion != null)
                {
                    completions.Insert(0, completion);
                }
            }
            else
            {
                await JS.InvokeVoidAsync("alert", message);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Error submitting claim: " + ex.Message);
        }
        finally
        {
            claimingQuestId   = -1;
            isSubmittingClaim = false;
            StateHasChanged();
        }
    }
}
