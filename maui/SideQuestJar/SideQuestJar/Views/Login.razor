@page "/login"
@using SideQuestJar.Services
@using SideQuestJar.ViewModels
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject NavbarViewModel NavbarViewModel

<div class="container min-vh-80 d-flex align-items-center">
    <div class="row justify-content-center w-100">
        <div class="col">
            <div class="row rounded-5 bg-block-blue p-4 align-items-center">
                <div class="col-md-6 text-center text-md-start mb-4 mb-md-0">
                    <h2 class="logo-first mt-3">SIDE QUEST</h2>
                    <h1 class="logo-second display-1">JAR</h1>
                    <br>
                    <p class="welcome-text m-1.5 fs-1" style="transform: rotate(5deg);">
                        Welcome to The Amazing Digital Side Quest Jar!
                    </p>
                </div>

                <div class="col-md-6">
                    <div class="card claim-modal-content rounded-5 border-0">
                        <div class="card-header border-0 claim-modal-header" style="background: transparent;">
                            <h5 class="claim-modal-title m-0">Login</h5>
                        </div>

                        <div class="card-body claim-modal-body">
                            <EditForm Model="@this" OnValidSubmit="HandleLogin">
                                
                                <div class="mb-3">
                                    <label for="email" class="claim-label">Email Address</label>
                                    <InputText id="email" type="email" class="form-control claim-input" @bind-Value="Email" placeholder="you@example.com" />
                                </div>

                                <div class="mb-3">
                                    <label for="password" class="claim-label">Password</label>
                                    <InputText id="password" type="password" class="form-control claim-input" @bind-Value="Password" placeholder="••••••••" />
                                </div>

                                @if(!string.IsNullOrEmpty(ErrorMessage))
                                {
                                    <div class="mt-2 small fw-bold mb-3" style="color:#FFD2C4;">
                                        @ErrorMessage
                                    </div>
                                }

                                <div class="d-flex flex-column gap-2 mt-4">
                                    <button type="submit" class="btn blue-button rounded-pill w-100 fw-bold fs-5 py-2">
                                        Login
                                    </button>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    public string Email { get; set; } = "";
    public string Password { get; set; } = "";
    public string ErrorMessage { get; set; } = "";

    private async Task HandleLogin()
    {
        ErrorMessage = "";
        if(string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Password))
        {
            ErrorMessage = "Please enter your email and password.";
            return;
        }

        var success = await AuthService.LoginAsync(Email, Password);
        
        if (success)
        {
            await NavbarViewModel.InitializeAsync();
            NavigationManager.NavigateTo("/");
        }
        else
        {
            ErrorMessage = string.IsNullOrEmpty(AuthService.LastLoginError)
                ? "Invalid credentials or server error."
                : AuthService.LastLoginError;
        }
    }
}
