<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SideQuestJar.ViewModels"
             x:Class="SideQuestJar.Components.NavbarView"
             x:DataType="viewmodels:GlobalAppState">

    <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,10" BackgroundColor="#222222">

        <Label Grid.Column="0" Text="SIDE QUEST JAR" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" />

        <HorizontalStackLayout Grid.Column="2" Spacing="15" VerticalOptions="Center">
            <Button Text="Home" Command="{Binding GoHomeCommand}" BackgroundColor="Transparent" TextColor="White" />

            <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsLoggedOut}">
                <Button Text="Login" Command="{Binding ShowLoginViewCommand}" />
                <Button Text="Register" Command="{Binding ShowRegisterViewCommand}" />
            </HorizontalStackLayout>

            <Button Text="Logout" 
                    Command="{Binding LogoutCommand}" 
                    IsVisible="{Binding IsLoggedIn}" 
                    BackgroundColor="DarkRed" 
                    TextColor="White" />
        </HorizontalStackLayout>
    </Grid>
</ContentView>