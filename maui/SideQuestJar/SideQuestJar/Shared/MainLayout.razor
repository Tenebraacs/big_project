@inherits LayoutComponentBase
@using Blazorise
@using SideQuestJar.ViewModels
@using SideQuestJar.Services
@inject NavbarViewModel ViewModel
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@implements IDisposable

<div id="app" class="d-flex flex-column min-vh-100">
    <nav class="navbar-base navbar navbar-expand-md navbar-light position-relative" style="z-index: 1050;">
        <div class="container-fluid">
            <!-- Top row -->
            <div class="nav-top w-100 d-flex align-items-center justify-content-between">
                <a class="navbar-brand mb-0 brand-link" href="/">
                    <span class="mobile-brand-logo d-md-none">SQJ</span>
                    <span class="logo-second fs-3 d-none d-md-inline" style="text-shadow: 0px 3px black; color: #EAB2A0;">
                        SideQuestJar
                    </span>
                </a>

                <div class="d-flex d-md-none align-items-center">
                    @if (ViewModel.IsLoggedIn && ViewModel.NavbarData != null)
                    {
                        <!-- Mobile Streak & Avatar -->
                        <div class="d-flex align-items-center gap-2 position-relative">
                            <span class="badge text-dark me-2" style="background-color: #EAB2A0; font-size: 1rem;">
                                <i class="bi bi-fire"></i> @ViewModel.NavbarData.Streak
                            </span>
                            
                            <!-- Mobile Dropdown Toggle -->
                            <a class="nav-link d-flex align-items-center" href="javascript:void(0)" @onclick="ToggleDropdown" @onclick:preventDefault>
                                <img src="@(ViewModel.NavbarData.User.ProfilePictureUrl ?? "https://i.ibb.co/689N9hY/default.jpg")" alt="Profile" class="rounded-circle" width="36" height="36" style="object-fit: cover;" />
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="auth-buttons d-flex align-items-center gap-2">
                            <a href="/login" class="guest-auth-chip text-decoration-none text-dark">
                                <i class="bi bi-box-arrow-in-right"></i>
                                <span>Login</span>
                            </a>
                            <a href="/register" class="guest-auth-chip text-decoration-none text-dark">
                                <i class="bi bi-person-plus"></i>
                                <span>Register</span>
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Desktop only collapsible area -->
            <div class="collapse navbar-collapse mt-3 mt-md-0 d-none d-md-flex" id="navbarSupportedContent">
                <div class="nav-inner w-100">
                    <div class="nav-left"></div>
                    
                    @if (ViewModel.IsLoggedIn && ViewModel.NavbarData != null)
                    {
                        <!-- Streak component -->
                        <div class="nav-center d-none d-md-flex">
                            <div class="streak-pill px-4 py-3 rounded-pill">
                                <div class="streak-week">
                                    @{ var days = new[] { "M", "T", "W", "T", "F", "S", "S" }; }
                                    @for (int i = 0; i < 7; i++)
                                    {
                                        var index = i;
                                        <div class="streak-day">
                                            <span class="streak-day-button 
                                                @(ViewModel.NavbarData.FilledIndexes.Contains(index) ? "filled" : "") 
                                                @(index == ViewModel.NavbarData.TodayIndex ? "today" : "")">
                                            </span>
                                            <small>@days[i]</small>
                                        </div>
                                    }
                                </div>
                                <div class="streak-divider"></div>
                                <div class="streak-count">
                                    <i class="bi bi-fire"></i>
                                    <span class="streak-number">@ViewModel.NavbarData.Streak</span>
                                    <span class="streak-label">day streak</span>
                                </div>
                            </div>
                        </div>

                        <!-- User Profile Menu Desktop -->
                        <div class="nav-right position-relative">
                            <ul class="navbar-nav">
                                <li class="nav-item dropdown user-dropdown">
                                    <a class="nav-link dropdown-toggle user-dropdown-toggle d-flex align-items-center gap-2"
                                       href="javascript:void(0)"
                                       @onclick="ToggleDropdown" @onclick:preventDefault>
                                        <span class="user-avatar">
                                            <img src="@(ViewModel.NavbarData.User.ProfilePictureUrl ?? "https://i.ibb.co/689N9hY/default.jpg")" alt="@ViewModel.NavbarData.User.Username">
                                        </span>
                                        <span class="user-name">@ViewModel.NavbarData.User.Username</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="nav-center"></div>
                        <div class="nav-right">
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <div class="auth-buttons d-flex align-items-center gap-2">
                                        <a href="/login" class="guest-auth-chip text-decoration-none text-dark">
                                            <i class="bi bi-box-arrow-in-right"></i>
                                            <span>Login</span>
                                        </a>
                                        <a href="/register" class="guest-auth-chip text-decoration-none text-dark">
                                            <i class="bi bi-person-plus"></i>
                                            <span>Register</span>
                                        </a>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
            
            <!-- Shared Dropdown Menu (Desktop & Mobile) -->
            @if (isDropdownOpen && ViewModel.IsLoggedIn && ViewModel.NavbarData != null)
            {
                <div class="dropdown-menu dropdown-menu-end user-dropdown-menu show" style="position: absolute; right: 1rem; top: 100%; margin-top: 0.5rem; z-index: 1055;">
                    <div class="user-dropdown-header">
                        <div class="user-dropdown-avatar">
                            <img src="@(ViewModel.NavbarData.User.ProfilePictureUrl ?? "https://i.ibb.co/689N9hY/default.jpg")" alt="@ViewModel.NavbarData.User.Username">
                        </div>
                        <div class="user-dropdown-info">
                            <div class="user-dropdown-name">@ViewModel.NavbarData.User.Username</div>
                        </div>
                    </div>

                    <div class="dropdown-divider"></div>

                    <!-- Mobile streak summary inside dropdown (Laravel style) -->
                    <div class="mobile-dropdown-streak d-md-none text-center py-2 px-3">
                        <div class="d-flex justify-content-between align-items-center w-100 bg-dark rounded-pill px-3 py-2 border border-secondary">
                            <span class="text-white fw-bold"><i class="bi bi-fire text-warning"></i> @ViewModel.NavbarData.Streak day streak</span>
                        </div>
                    </div>

                    <div class="dropdown-divider d-md-none"></div>

                    <a class="dropdown-item user-dropdown-item" href="/profile" @onclick="CloseDropdown">
                        <i class="bi bi-person-circle me-2"></i> Profile
                    </a>
                    <a class="dropdown-item user-dropdown-item" href="/friends" @onclick="CloseDropdown">
                        <i class="bi bi-people-fill me-2"></i> Friends
                    </a>
                    <a class="dropdown-item user-dropdown-item" href="/messages" @onclick="CloseDropdown">
                        <i class="bi bi-chat-dots-fill me-2"></i> Chat
                    </a>
                    <a class="dropdown-item user-dropdown-item" href="/jars/create" @onclick="CloseDropdown">
                        <i class="bi bi-plus-circle me-2"></i> Create Jar
                    </a>

                    @if (ViewModel.NavbarData.User.IsAdmin)
                    {
                        <a class="dropdown-item user-dropdown-item" href="/admin" @onclick="CloseDropdown">
                            <i class="bi bi-shield-lock-fill me-2"></i> Admin Panel
                        </a>
                    }

                    <div class="dropdown-divider"></div>

                    <button type="button" class="dropdown-item user-dropdown-item user-dropdown-logout w-100 text-start" @onclick="HandleLogout">
                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                    </button>
                </div>
            }
        </div>
    </nav>

    <!-- Invisible backdrop to close dropdown when clicking outside -->
    @if (isDropdownOpen)
    {
        <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1040;" @onclick="CloseDropdown"></div>
    }

    <main class="flex-grow-1" style="position: relative; z-index: 1;">
        @Body
    </main>
</div>

@code {
    private bool isDropdownOpen = false;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += (s, e) => InvokeAsync(StateHasChanged);
        await ViewModel.InitializeAsync();
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private void CloseDropdown()
    {
        isDropdownOpen = false;
    }

    private async Task HandleLogout()
    {
        isDropdownOpen = false;
        await AuthService.LogoutAsync();
        ViewModel.IsLoggedIn = false;
        ViewModel.NavbarData = null;
        NavigationManager.NavigateTo("/login");
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= (s, e) => InvokeAsync(StateHasChanged);
    }
}
